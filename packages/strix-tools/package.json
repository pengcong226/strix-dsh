{
  "name": "strix-dsh-tools",
  "description": "StriX-DH: offensive-security tool suite for the DeepSeek Harness — natively re-hosts Strix's pentest capabilities (HTTP client, sandboxed shell, Python exploit box, browser automation, recon, SAST, evidence-bound findings) as dsh tools.",
  "version": "0.10.1",
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "files": [
    "dist",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-jobs": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-skill": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.5",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.49.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_ORG/strix-dsh.git"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "security",
    "pentest",
    "offensive-security",
    "strix"
  ]
}
